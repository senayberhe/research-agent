# Alertmanager email settings. Copy to .env.alertmanager (ignored by git)
# and fill in. The SMTP password goes in
# monitoring/alertmanager/secrets/smtp_password (also ignored), not here.

# host:port of your SMTP server, e.g. smtp.gmail.com:587
SMTP_SMARTHOST=smtp.example.com:587

# Sender address.
SMTP_FROM=alerts@example.com

# Login for the SMTP server (often the sender address).
SMTP_USERNAME=alerts@example.com

# true for real SMTP servers (STARTTLS); false only for a local test server.
SMTP_REQUIRE_TLS=true

# Who receives the alerts.
ALERT_EMAIL_TO=you@example.com
