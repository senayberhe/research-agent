DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/research_db
TAVILY_API_KEY=your_tavily_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ENVIRONMENT=development
LOG_LEVEL=INFO

# Research agent limits
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_RETRIES=2
AGENT_MAX_QUERY_LENGTH=500
AGENT_MAX_RESULT_LENGTH=12000
AGENT_MAX_EXECUTION_SECONDS=300
AGENT_MAX_TOTAL_TOKENS=20000
AGENT_RESUME_ON_STARTUP=true
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=3
WORKER_HEARTBEAT_SECONDS=30
WORKER_SHUTDOWN_TIMEOUT_SECONDS=240

# Rolling window for SLOs and error budgets.
SLO_WINDOW_DAYS=30

# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:5173"]


# OpenAI model for the agent (gpt-5.6-sol / gpt-5.6-terra / gpt-5.6-luna)
LLM_MODEL=gpt-5.6-terra

# Authentication: a session cookie. How long a sign-in lasts, and whether
# the cookie is HTTPS-only (turn on wherever the app is served over HTTPS).
AUTH_SESSION_HOURS=8
AUTH_COOKIE_SECURE=false
# Failed sign-ins allowed per username / per address in the window.
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_MAX_FAILURES_PER_IP=20
# AUTH_LOGIN_WINDOW_SECONDS=300
# Optional first user, created on startup when there are no users yet.
# AUTH_ADMIN_USERNAME=admin
# AUTH_ADMIN_PASSWORD=
